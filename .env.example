# UniAdvisor AI — environment variables
# Copy this file to .env and fill in the values. Never commit .env.
# The backend (main.py, rag.py) reads .env via python-dotenv; Vite reads the VITE_* lines at build time.

# ── Backend: database (required) ──────────────────────────────
# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
# Supabase service-role key; backend only, bypasses row-level security, never put it in the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Backend: security (required) ──────────────────────────────
# Secret for signing login tokens; generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-string

# ── Backend: LLM (Groq) ───────────────────────────────────────
# First Groq API key (console.groq.com); add GROQ_API_KEY_2, _3, ... to rotate keys on rate limits
GROQ_API_KEY_1=your-groq-api-key
# Optional second key, tried when the first is rate-limited
# GROQ_API_KEY_2=your-second-groq-api-key
# Optional single-key alternative, used only when GROQ_API_KEY_1 is not set
# GROQ_API_KEY=your-groq-api-key
# Model used for answers and translation (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b
# Optional comma-separated models to try when a key is rate-limited (default: none)
GROQ_FALLBACK_MODELS=

# ── Backend: retrieval and answer prompt ──────────────────────
# baseline | stopwords | translate — retrieval variant; production uses translate (code default: baseline)
RETRIEVAL_MODE=translate
# default | strict — answer prompt; strict = answer only from the context, otherwise say "I don't know"
PROMPT_MODE=default

# ── Backend: local storage (optional) ─────────────────────────
# Folder for the local chunk cache used when Supabase is unavailable (default: ./uploaded_docs)
DOCS_DIR=./uploaded_docs

# ── Frontend (read by Vite at build time) ─────────────────────
# Backend URL; leave empty when the backend serves the built frontend (same origin)
VITE_API_URL=
# Supabase project URL for the frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon (public) key for the frontend; never the service-role key
VITE_SUPABASE_ANON_KEY=your-anon-key
